{
  "version": 2,
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/.netlify/functions/biotech-veille",
      "destination": "https://biogy.netlify.app/.netlify/functions/biotech-veille"
    },
    {
      "source": "/api/:path*",
      "destination": "https://biogy.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
